{
  "tag": "vsc-tree-item",
  "kind": "component",
  "title": "Tree item",
  "category": "widgets",
  "description": "A row of the Explorer tree (`.monaco-list-row`): twistie, Seti file/folder icon and label. Selection uses inactive-selection colors (list not focused).",
  "attributes": [
    {
      "name": "label",
      "type": "string",
      "description": "File or folder name (drives the file icon)"
    },
    {
      "name": "kind",
      "type": "enum",
      "values": [
        "file",
        "folder"
      ],
      "default": "file"
    },
    {
      "name": "level",
      "type": "number",
      "default": "1",
      "description": "Nesting depth (1 = top level)"
    },
    {
      "name": "expanded",
      "type": "boolean",
      "description": "Folder is expanded"
    },
    {
      "name": "selected",
      "type": "boolean"
    },
    {
      "name": "focused",
      "type": "boolean"
    },
    {
      "name": "language",
      "type": "string",
      "description": "Language id override for the icon"
    }
  ],
