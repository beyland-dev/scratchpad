{
  "tag": "vsc-chat-tool-call",
  "kind": "component",
  "title": "Chat tool call",
  "category": "chat",
  "description": "One completed tool call in a chat response (`.chat-thinking-tool-wrapper`): a compact codicon and a past-tense message, optionally followed by a file pill. With `edit`, it renders the edited-file row (\"Edited\" + file pill with +added/-removed line counts).",
  "usage": "Inside <vsc-chat-tool-chain>. Children are the message (inline HTML like <strong>/<code> allowed), e.g. \"Ran npm test\". Pick a compact codicon matching the tool: search-compact, book-compact (read), pencil (edit), terminal-compact (shell), tools (other).",
  "attributes": [
    {
      "name": "icon",
      "type": "string",
      "default": "tools",
      "description": "Codicon name, e.g. search-compact, book-compact, pencil, terminal-compact"
    },
    {
      "name": "file",
      "type": "string",
      "description": "File shown as a pill after the message (or the edited file with edit)"
    },
    {
      "name": "edit",
      "type": "boolean",
      "description": "Render the edited-file row (status label + file pill with line counts)"
    },
    {
      "name": "added",
      "type": "number",
      "description": "Lines added (edit)"
    },
    {
      "name": "removed",
      "type": "number",
      "description": "Lines removed (edit)"
    },
    {
      "name": "running",
      "type": "boolean",
      "description": "In progress: the icon becomes a spinning loading codicon (present-tense message)"
    }
  ],
  "slots": [
    {
      "name": "",
      "description": "Past-tense message (default \"Edited\" with edit)"
    }
  ],
  "states": [
    {
      "name": "running",
      "description": "Tool call still in progress",
      "trigger": "running attribute"
    }
  ],
  "variants": [],
  "hostDisplay": "block",
  "hostTag": "div",
  "cssCaptures": [],
  "requires": [
    "vsc-workbench",
    "vsc-chat-view",
    "vsc-chat-response",
    "vsc-chat-tool-chain"
  ],
  "tokens": [],
  "uses": [],
