    },
    {
      "path": "src/vs/workbench/contrib/chat/browser/widget/chatContentParts/codeBlockPart.ts",
      "note": "chat-codeblock-pill-widget"
    }
  ],
  "examples": [
    {
      "title": "Read file",
      "html": "<vsc-chat-response><vsc-chat-tool-chain><vsc-chat-tool-call icon=\"book-compact\" file=\"renderer.ts\">Read</vsc-chat-tool-call></vsc-chat-tool-chain></vsc-chat-response>",
      "width": 720
    },
    {
      "title": "Edited file",
      "html": "<vsc-chat-response><vsc-chat-tool-chain><vsc-chat-tool-call edit icon=\"pencil\" file=\"renderer.ts\" added=\"14\" removed=\"3\"></vsc-chat-tool-call></vsc-chat-tool-chain></vsc-chat-response>",
      "width": 720
    },
    {
      "title": "Shell",
