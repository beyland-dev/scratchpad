{
  "tag": "vsc-chat-mode-picker",
  "kind": "component",
  "title": "Chat mode picker",
  "category": "chat",
  "description": "Copilot's combined Mode and Permissions picker in the Agents window composer: a split button (\"Interactive | Allow all\") whose halves open one popup with the Agent mode (Interactive, Plan, Autopilot) or Permissions (Manual, Assisted, Allow all, terminal sandboxing) section expanded. The permission summary is colored for Assisted (`.warning`) and Allow all (`.info`); a sandboxed terminal adds a shield. Cloud sessions use the cloud mode descriptions.",
  "usage": "Rendered by <vsc-chat-input variant=\"session|new-session\" harness=\"copilot\">.",
  "attributes": [
    {
      "name": "mode",
      "type": "enum",
      "values": [
        "interactive",
        "plan",
        "autopilot"
      ],
      "default": "interactive"
    },
    {
      "name": "permissions",
      "type": "enum",
      "values": [
        "manual",
        "assisted",
        "allow-all"
      ],
      "default": "allow-all"
    },
    {
      "name": "sandbox",
      "type": "boolean"
    },
    {
      "name": "environment",
      "type": "enum",
      "values": [
        "local",
        "cloud"
      ],
      "default": "local"
    },
    {
      "name": "disabled",
      "type": "boolean"
    }
  ],
  "slots": [],
  "states": [
    {
      "name": "change (event)",
      "description": "detail: { mode, permissions, sandbox }",
      "trigger": "choose a mode, permission level or toggle sandboxing"
    },
    {
      "name": "configure-permissions (event)",
      "trigger": "the Permissions section's gear"
    },
    {
      "name": "compact",
      "description": "the mode's icon only, without the permissions half (compact-picker). Set by the composer's responsive pass; CSS from source (not captured).",
      "trigger": "the composer runs out of room"
    }
  ],
  "variants": [],
  "hostDisplay": "block",
  "hostTag": "li",
  "cssCaptures": [
    "agents-session-composer-light",
    "agents-session-composer-dark",
    "agents-new-session-composer-light",
    "agents-new-session-composer-dark"
  ],
  "requires": [
    "vsc-workbench"
  ],
  "tokens": [],
  "uses": [
    "vsc-action-list"
  ],
  "sources": [
    {
      "path": "src/vs/workbench/contrib/chat/browser/agentSessions/agentHost/agentHostModePickerPresentation.ts"
    },
    {
      "path": "src/vs/workbench/contrib/chat/browser/agentSessions/agentHost/agentHostChatInputPicker.ts"
    }
  ],
  "examples": [
    {
      "title": "Interactive, Allow all",
      "html": "<vsc-workbench window=\"agents\"><vsc-session-view style=\"width: 480px\"><vsc-chat-input variant=\"session\"></vsc-chat-input></vsc-session-view></vsc-workbench>"
    }
  ],
  "references": [],
