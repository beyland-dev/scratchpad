{
  "tag": "vsc-chat-model-list",
  "kind": "component",
  "title": "Chat model list",
  "category": "chat",
  "description": "Model picker popup (widget/input/modelPicker): a tabbed action list with the provider tab bar, the harness's models (featured Copilot Fusion, the recommended models, then a collapsible \"Other Models\" section), each with its configuration summary (\"Medium · 272K\"), and the Send Query to Multiple Models footer. Choosing a model's summary opens its details: Effort Level, Context Size and Speed as segmented controls, plus collapsible pricing (credits per 1M tokens). Models, effort levels, context sizes and pricing come from ds.chatPickers, captured from the signed-in product: 23 Copilot models, Claude's 8 and Codex's 10. In an open session it shows the prompt-cache notice. Fires `select` and `configure`.",
  "usage": "Opened by <vsc-chat-model-picker model=…> (or `ds.openModelList(anchor, { harness, model, details, notice, onSelect, onConfigure })`). Place statically with `x`/`y` for mockups of the open state.",
  "attributes": [
    {
      "name": "harness",
      "type": "enum",
      "values": [
        "copilot",
        "claude",
        "codex"
      ],
      "default": "copilot"
    },
    {
      "name": "model",
      "type": "string",
      "description": "Selected model id, e.g. claude-opus-5-5 (defaults to the harness's default)"
    },
    {
      "name": "expanded",
      "type": "boolean",
      "description": "Other Models section open"
    },
    {
      "name": "details",
      "type": "string",
      "description": "Model id whose details card is shown"
    },
    {
      "name": "notice",
      "type": "string",
      "description": "Header notice; empty shows the mid-session prompt-cache notice"
    },
    {
      "name": "max-height",
      "type": "number",
      "default": "480"
    },
    {
      "name": "position",
      "type": "enum",
      "values": [
        "below",
        "above"
      ]
    },
    {
      "name": "x",
      "type": "number"
    },
    {
      "name": "y",
      "type": "number"
    }
  ],
  "slots": [],
  "states": [
    {
      "name": "expanded",
      "trigger": "choose Other Models"
    },
    {
      "name": "details",
      "description": "`.showing-details` with the model card",
      "trigger": "choose a model's summary"
    },
    {
      "name": "select (event)",
      "trigger": "choose a model"
    },
    {
      "name": "configure (event)",
      "trigger": "change effort, context size or speed"
    }
  ],
