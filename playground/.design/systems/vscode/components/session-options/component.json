{
  "tag": "vsc-session-options",
  "kind": "component",
  "title": "Session options",
  "category": "chat",
  "description": "New-session options (sessions.chat.experimental.newSessionComposerLayout): the strip of session pickers above the new-session composer: environment, workspace, the repository controls (isolation | branch) and the harness, plus the collapse toggle. Mirrors `.new-session-workspace-picker-container` in sessionWorkspacePicker.ts. Cloud sessions have no repository controls and show the harness without a picker; a workspace-less chat has no repository either. Every picker opens its real options.",
  "usage": "Rendered by <vsc-chat-input variant=\"new-session\">; use it on its own only inside `.new-chat-widget-content.experimental-new-session-composer`.",
  "attributes": [
    {
      "name": "environment",
      "type": "enum",
      "values": [
        "local",
        "cloud"
      ],
      "default": "local"
    },
    {
      "name": "workspace",
      "type": "string",
      "default": "adt",
      "description": "Workspace id from ds.chatPickers.data.workspaces (\"chat\" = no workspace)"
    },
    {
      "name": "isolation",
      "type": "enum",
      "values": [
        "branch",
        "worktree"
      ],
      "default": "branch"
    },
    {
      "name": "branch",
      "type": "string",
      "default": "main"
    },
    {
      "name": "harness",
      "type": "enum",
      "values": [
        "copilot",
        "claude",
        "codex"
      ],
      "default": "copilot"
    }
  ],
  "slots": [],
  "states": [
    {
      "name": "change (event)",
      "description": "detail: { kind, value, option, options }",
      "trigger": "pick an option"
    },
    {
      "name": "toggle-options (event)",
      "trigger": "click the chevron"
    }
  ],
  "variants": [],
  "hostDisplay": "block",
  "cssCaptures": [
    "agents-new-session-composer-light",
    "agents-new-session-composer-dark"
  ],
  "requires": [
    "vsc-workbench"
  ],
  "tokens": [],
  "uses": [
    "vsc-session-picker"
  ],
  "sources": [
    {
      "path": "src/vs/sessions/contrib/chat/browser/sessionWorkspacePicker.ts"
    },
    {
      "path": "src/vs/sessions/contrib/chat/browser/sharedChatInputComposer.ts"
    }
  ],
  "examples": [
    {
      "title": "Default",
      "html": "<vsc-workbench window=\"agents\"><vsc-session-view variant=\"new\" style=\"width: 800px\"><div class=\"new-chat-widget-content chat-input-stack experimental-new-session-composer\"><vsc-session-options></vsc-session-options></div></vsc-session-view></vsc-workbench>"
    },
    {
      "title": "Cloud",
      "html": "<vsc-workbench window=\"agents\"><vsc-session-view variant=\"new\" style=\"width: 800px\"><div class=\"new-chat-widget-content chat-input-stack experimental-new-session-composer\"><vsc-session-options environment=\"cloud\" workspace=\"vscode\"></vsc-session-options></div></vsc-session-view></vsc-workbench>"
    }
  ],
  "references": [],
  "status": "draft",
  "createdAt": "2026-10-28T01:15:18.714Z",
  "updatedAt": "2026-10-28T01:15:18.714Z"
}
