  "examples": [
    {
      "title": "Commonly used",
      "html": "<vsc-settings-group label=\"Commonly Used\"></vsc-settings-group><vsc-setting type=\"number\" category=\"Editor: \" label=\"Font Size\" key=\"editor.fontSize\" value=\"14\">Controls the font size in pixels.</vsc-setting><vsc-setting type=\"bool\" category=\"Editor: \" label=\"Format On Save\" key=\"editor.formatOnSave\">Format a file on save. A formatter must be available and the editor must not be shutting down. When <a href=\"\" title=\"files.autoSave\" data-href=\"#files.autoSave\">Files: Auto Save</a> is set to <code>afterDelay</code>, the file will only be formatted when saved explicitly.</vsc-setting><vsc-setting type=\"enum\" category=\"Files: \" label=\"Auto Save\" key=\"files.autoSave\" options=\"off,afterDelay,onFocusChange,onWindowChange\" value=\"afterDelay\">Controls <a href=\"https://code.visualstudio.com/docs/editor/codebasics#_save-auto-save\">auto save</a> of editors that have unsaved changes.</vsc-setting><vsc-setting type=\"text\" category=\"Editor: \" label=\"Font Family\" key=\"editor.fontFamily\" value=\"'Droid Sans Mono', monospace\">Controls the font family.</vsc-setting>"
    }
