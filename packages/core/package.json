{
  "name": "@beyland/sprue-core",
  "version": "0.5.0",
  "description": "Headless core for Sprue: workspace model, file storage, and command registry.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./family": "./src/family.ts",
    "./review-manifest": "./src/review-manifest.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./family": "./dist/family.mjs",
      "./review-manifest": "./dist/review-manifest.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:review && vp pack && node ./scripts/copy-review.mjs",
    "build:review": "pnpm --filter @beyland/sprue-review build",
    "test": "vp test"
  },
  "dependencies": {
    "chokidar": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
