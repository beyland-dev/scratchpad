{
  "name": "@beyland/sprue",
  "version": "0.3.0",
  "description": "The `Sprue` (`sp`) command line: serve the app, run the MCP server, and call any core command.",
  "license": "MIT",
  "bin": {
    "sp": "./src/bin.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "sp": "./dist/bin.mjs"
    },
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node ./scripts/copy-web.mjs",
    "build:standalone": "pnpm run build:web && pnpm run build",
    "build:web": "pnpm --filter @beyland/sprue-web build",
    "dev": "node --watch ./src/bin.ts serve --no-open --dev-origin http://localhost:5173",
    "prepublishOnly": "pnpm run build:standalone",
    "test": "vp test"
  },
  "dependencies": {
    "@beyland/sprue-capture": "workspace:*",
    "@beyland/sprue-core": "workspace:*",
    "@beyland/sprue-mcp": "workspace:*",
    "@beyland/sprue-server": "workspace:*",
    "jsonc-parser": "catalog:"
  },
  "devDependencies": {
    "@beyland/sprue-web": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
