{
  "name": "@beyland/scratchpad",
  "version": "0.0.0",
  "description": "The `Scratchpad` (`sp`) command line: serve the app, run the MCP server, and call any core command.",
  "license": "MIT",
  "bin": {
    "scratchpad": "./src/bin.ts",
    "sp": "./src/bin.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "scratchpad": "./dist/bin.mjs",
      "sp": "./dist/bin.mjs"
    },
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "node --watch ./src/bin.ts serve --no-open --dev-origin http://localhost:5173",
    "test": "vp test"
  },
  "dependencies": {
    "@beyland/scratchpad-capture": "workspace:*",
    "@beyland/scratchpad-core": "workspace:*",
    "@beyland/scratchpad-mcp": "workspace:*",
    "@beyland/scratchpad-server": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
